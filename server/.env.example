# Server environment - for deployment (never commit real secrets)
# https://github.com/vitest-dev/vite/issues/1813

# Port
PORT=4000

# Environment
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/royal-higher-life?retryWrites=true&w=majority

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this

# CORS - origin that should match your frontend domain
FRONTEND_URL=http://localhost:5174

# ---------------------------------------------------------------------------
# Google OAuth (backend-only - never expose client_secret in frontend)
# Register these in Google Cloud Console -> APIs & Services -> Credentials
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ---------------------------------------------------------------------------
# Facebook OAuth (backend-only - never expose client_secret in frontend)
# Register these in Meta for Developers -> Apps -> Settings -> Basic
# ---------------------------------------------------------------------------
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# ---------------------------------------------------------------------------
# OAuth redirect URI (must match exactly what's set in provider consoles)
# Local: http://localhost:5173/api/auth/social/google/facebook
# Production: https://your-domain.com/api/auth/social/google/facebook
# ---------------------------------------------------------------------------
SOCIAL_REDIRECT_URI=http://localhost:5173/api/auth/social/callback

# ---------------------------------------------------------------------------
# First super admin bootstrap (run once after deployment)
# Set these env vars once, then delete or comment out.
# Never expose these in frontend or commit to version control.
# ---------------------------------------------------------------------------
# FIRST_SUPER_ADMIN_NAME=Super Administrator
# FIRST_SUPER_ADMIN_EMAIL=admin@royal-higherlife.org
# FIRST_SUPER_ADMIN_PASSWORD=SecureAdminPass123!

# ---------------------------------------------------------------------------
# Payment providers (optional)
# ---------------------------------------------------------------------------
# PAYSTACK_SECRET_KEY=
# PAYSTACK_ACCOUNT_COUNTRY=NG
# PAYSTACK_SUPPORTED_CURRENCIES=NGN,USD
#
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENVIRONMENT=sandbox

# ---------------------------------------------------------------------------
# Email (Resend optional)
# ---------------------------------------------------------------------------
# RESEND_API_KEY=
# EMAIL_FROM=Royal HigherLife <receipts@your-verified-domain.com>